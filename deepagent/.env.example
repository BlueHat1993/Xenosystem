# DeepSeek (required) — get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat (default) or deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=4096

# Web search (recommended). Get one at https://tavily.com
# If empty, agent falls back to DuckDuckGo (no key needed).
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# Workspace and capability policy
DEEPAGENT_WORKSPACE_ROOT=.
DEEPAGENT_ALLOW_REPORT_WRITES=true
# Generated tools remain disabled until an isolated sandbox is configured.
DEEPAGENT_ENABLE_DYNAMIC_TOOLS=false
DEEPAGENT_REQUIRE_TOOL_APPROVAL=true
DEEPAGENT_MAX_TOOL_SECONDS=30

# Optional tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
